.claude/**
.github/**
Extension.code-workspace
.vscode/**
.vscode-test/**
coverage/**
src/**
webview/**
.gitignore
**/.DS_Store
.nvmrc
.yarnrc
**/tsconfig.json
**/tsconfig.webview.json
**/eslint.config.mjs
**/vite.config.ts
**/vite.webview.config.ts
**/vitest.config.ts
**/*.map
**/*.ts
# What ships from dist/, by type: a negated pattern wins over every ignore
# in vsce, so `!dist/**` would bring the source maps back.
!dist/**/*.js
!dist/**/*.css
!dist/**/*.svg
!dist/**/*.ttf
# The images by type too: `!images/**` would bring back what a Mac's Finder
# leaves there, `.DS_Store`.
!images/**/*.svg
!images/**/*.png
ui-test/**
out/**

# The build tools - the grammar's and the skill sync - and the grammar's
# inputs: only the built grammars and the synced skills ship. skills/ is
# gitignored but ships: vsce reads this file, not .gitignore.
tools/**
skills.new/**
syntaxes/mariadb-sql.template.json
syntaxes/words.json
